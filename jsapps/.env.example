# Local dev port allocation (see ~/.claude/docs/port-allocation.md).
# splitease's registered block is base 43200; the web/vite dev server is +0.
# Copy this into .env.local (or export it in your shell) — never hardcode the
# port anywhere else. Changing blocks is then a one-line edit here.
PORT_BASE=43200

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
